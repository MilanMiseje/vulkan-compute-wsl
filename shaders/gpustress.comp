#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer DataBuffer
{
    float data[];
};

void main()
{
    uint i = gl_GlobalInvocationID.x;

    float x = data[i];

    for (uint j = 0; j < 10000; ++j)
    {
        x = sin(x) * cos(x) + sqrt(abs(x) + 1.0);
    }

    data[i] = x;
}
